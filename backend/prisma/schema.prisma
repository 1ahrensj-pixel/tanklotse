// Prisma-Schema für TankLotse
// PostgreSQL + PostGIS. Geography-Spalte für stations_cache.location wird via
// Raw-Migration ergänzt (Prisma kennt PostGIS-Typen nicht nativ).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // native = lokale Entwicklung (Windows/macOS/Linux-glibc).
  // linux-musl-openssl-3.0.x = Alpine-Container in Production (Render/Docker).
  // Ohne den musl-Target kann die Query-Engine im Alpine-Image nicht laden.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// =============================================================================
// Enums
// =============================================================================

enum Role {
  USER
  ADMIN
  SUPPORT
  DEVELOPER
  READONLY
  SUPERADMIN
}

enum PremiumStatus {
  NONE
  ACTIVE
  GRACE
  CANCELLED
  EXPIRED
}

enum FuelType {
  E5
  E10
  DIESEL
}

enum PriceStatus {
  OPEN
  CLOSED
  NO_PRICES
  UNKNOWN
}

enum ConsentType {
  TERMS
  PRIVACY
  LOCATION
  PUSH
  ANALYTICS
}

enum ComplaintType {
  WRONG_PRICE_E5
  WRONG_PRICE_E10
  WRONG_PRICE_DIESEL
  WRONG_STATUS
  WRONG_NAME
  WRONG_ADDRESS
  WRONG_BRAND
  WRONG_LOCATION
  OTHER
}

enum ComplaintStatus {
  PENDING
  FORWARDED
  ACCEPTED
  REJECTED
  DUPLICATE
}

enum Platform {
  IOS
  ANDROID
  WEB
}

enum SubscriptionProvider {
  APPLE
  GOOGLE
  STRIPE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  GRACE
  PENDING
}

enum AlertType {
  MAX_PRICE
  REAL_SAVING
}

// =============================================================================
// Tabellen
// =============================================================================

model User {
  id             String        @id @default(uuid()) @db.Uuid
  email          String?       @unique
  passwordHash   String?       @map("password_hash")
  appleId        String?       @unique @map("apple_id")
  googleId       String?       @unique @map("google_id")
  role           Role          @default(USER)
  emailVerified  Boolean       @default(false) @map("email_verified")
  premiumStatus  PremiumStatus @default(NONE) @map("premium_status")
  totpSecret     String?       @map("totp_secret")
  totpEnabled    Boolean       @default(false) @map("totp_enabled")
  failedLogins   Int           @default(0) @map("failed_logins")
  lockedUntil    DateTime?     @map("locked_until")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  consents       UserConsent[]
  vehicles       Vehicle[]
  favorites      Favorite[]
  alerts         PriceAlert[]
  pushTokens     PushToken[]
  complaints     Complaint[]
  subscriptions  Subscription[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  emailTokens    EmailToken[]
  savedRoutes    SavedRoute[]

  @@index([email])
  @@map("users")
}

model UserConsent {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  type      ConsentType
  accepted  Boolean
  version   String
  createdAt DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_consents")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  userAgent  String?   @map("user_agent")
  ipPrefix   String?   @map("ip_prefix")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  purpose   String
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_tokens")
}

model Vehicle {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  name                  String
  fuelType              FuelType @map("fuel_type")
  consumptionLPer100Km  Decimal  @map("consumption_l_per_100km") @db.Decimal(5, 2)
  typicalTankLiters     Decimal  @map("typical_tank_liters") @db.Decimal(6, 2)
  isDefault             Boolean  @default(false) @map("is_default")
  isCommercial          Boolean  @default(false) @map("is_commercial")
  vehicleClass          String?  @map("vehicle_class")
  drivingProfile        String?  @map("driving_profile")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedRoutes  SavedRoute[]

  @@index([userId])
  @@map("vehicles")
}

model Station {
  id                String   @id @db.Uuid
  name              String
  brand             String
  street            String
  houseNumber       String?  @map("house_number")
  postCode          String   @map("post_code")
  place             String
  lat               Decimal  @db.Decimal(9, 6)
  lng               Decimal  @db.Decimal(9, 6)
  // location: geography(Point, 4326) — wird per Raw-SQL-Migration angelegt.
  lastDetailUpdate  DateTime? @map("last_detail_update")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  prices       StationPrice[]
  favorites    Favorite[]
  alerts       PriceAlert[]
  complaints   Complaint[]

  @@index([brand])
  @@index([postCode])
  @@map("stations_cache")
}

model StationPrice {
  id              String      @id @default(uuid()) @db.Uuid
  stationId       String      @map("station_id") @db.Uuid
  fuelType        FuelType    @map("fuel_type")
  price           Decimal     @db.Decimal(6, 3)
  status          PriceStatus
  isOpen          Boolean     @map("is_open")
  source          String
  sourceTimestamp DateTime?   @map("source_timestamp")
  fetchedAt       DateTime    @default(now()) @map("fetched_at")

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, fuelType, fetchedAt])
  @@map("station_price_cache")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  stationId String   @map("station_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([userId, stationId])
  @@index([userId])
  @@map("favorites")
}

model PriceAlert {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  stationId            String?   @map("station_id") @db.Uuid
  fuelType             FuelType  @map("fuel_type")
  radiusKm             Decimal?  @map("radius_km") @db.Decimal(5, 2)
  lat                  Decimal?  @db.Decimal(9, 6)
  lng                  Decimal?  @db.Decimal(9, 6)
  maxPrice             Decimal   @map("max_price") @db.Decimal(6, 3)
  active               Boolean   @default(true)
  daysOfWeek           Json      @map("days_of_week")
  timeWindowStart      String?   @map("time_window_start")
  timeWindowEnd        String?   @map("time_window_end")
  lastTriggeredAt      DateTime? @map("last_triggered_at")
  alertType            AlertType @default(MAX_PRICE) @map("alert_type")
  minRealSavingEur     Decimal?  @map("min_real_saving_eur") @db.Decimal(6, 2)
  tankLiters           Decimal?  @map("tank_liters") @db.Decimal(6, 2)
  consumptionLPer100Km Decimal?  @map("consumption_l_per_100km") @db.Decimal(5, 2)
  maxExtraDistanceKm   Decimal?  @map("max_extra_distance_km") @db.Decimal(5, 2)
  onlyOpen             Boolean   @default(true) @map("only_open")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  station Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  @@index([userId, active])
  @@index([active, fuelType])
  @@index([active, alertType])
  @@map("price_alerts")
}

model SavedRoute {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  name              String
  startLabel        String    @map("start_label")
  startLat          Decimal   @map("start_lat") @db.Decimal(9, 6)
  startLng          Decimal   @map("start_lng") @db.Decimal(9, 6)
  endLabel          String    @map("end_label")
  endLat            Decimal   @map("end_lat") @db.Decimal(9, 6)
  endLng            Decimal   @map("end_lng") @db.Decimal(9, 6)
  fuelType          FuelType  @map("fuel_type")
  defaultVehicleId  String?   @map("default_vehicle_id") @db.Uuid
  maxDetourKm       Decimal   @default(3) @map("max_detour_km") @db.Decimal(5, 2)
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [defaultVehicleId], references: [id], onDelete: SetNull)

  @@index([userId, active])
  @@map("saved_routes")
}

model PushToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  deviceId   String    @map("device_id")
  platform   Platform
  fcmToken   String    @unique @map("fcm_token")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("push_tokens")
}

model Complaint {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String?         @map("user_id") @db.Uuid
  stationId     String          @map("station_id") @db.Uuid
  complaintType ComplaintType   @map("complaint_type")
  correction    String?
  status        ComplaintStatus @default(PENDING)
  forwardedAt   DateTime?       @map("forwarded_at")
  createdAt     DateTime        @default(now()) @map("created_at")

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId])
  @@index([status])
  @@map("complaints")
}

model ApiLog {
  id           String   @id @default(uuid()) @db.Uuid
  provider     String
  endpoint     String
  statusCode   Int      @map("status_code")
  ok           Boolean
  durationMs   Int      @map("duration_ms")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([provider, createdAt])
  @@index([ok, createdAt])
  @@map("api_logs")
}

model Subscription {
  id         String               @id @default(uuid()) @db.Uuid
  userId     String               @map("user_id") @db.Uuid
  provider   SubscriptionProvider
  status     SubscriptionStatus
  productId  String               @map("product_id")
  expiresAt  DateTime?            @map("expires_at")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("subscriptions")
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("feature_flags")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  target    String?
  metadata  Json?
  ipPrefix  String?  @map("ip_prefix")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
