# =============================================================================
# TankLotse — Production-Environment-Beispiel
# =============================================================================
# Diese Datei beschreibt den vollstaendigen Stand fuer die Produktionsumgebung.
# Sie enthaelt KEINE echten Secrets. Alle Werte sind klar als Platzhalter
# erkennbar (`replace-me` / `replace-with-min-32-characters`).
#
# Beim Deployment in echte Production die Werte ersetzen — am besten ueber
# Docker-Secrets, Server-Panel oder Deployment-System, NICHT in einer
# eingecheckten Datei.
#
# Doku: docs/48-external-api-configuration.md
# =============================================================================

# --- Allgemein --------------------------------------------------------------
NODE_ENV=production
PORT=3000
PUBLIC_API_BASE_URL=https://api.tanklotse.de
APP_NAME=TankLotse
APP_ENV=production
API_BASE_URL=https://api.tanklotse.de

# Swagger UI unter /docs/api. In production standardmaessig AUS — bewusst per
# `SWAGGER_ENABLED=true` aktivieren, falls intern gebraucht. Nicht oeffentlich
# ohne zusaetzlichen Schutz (IP-Allowlist / Auth-Proxy) betreiben.
SWAGGER_ENABLED=false

# --- Datenbank + Cache ------------------------------------------------------
# Pflicht in Production.
DATABASE_URL=postgresql://tanklotse:replace-with-strong-password@postgres:5432/tanklotse
POSTGRES_USER=tanklotse
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=tanklotse
REDIS_URL=redis://redis:6379

# --- Auth / Tokens / Cookies -----------------------------------------------
# Pflicht in Production. Mindestlaenge je 32 Zeichen.
JWT_ACCESS_SECRET=please-set-strong-secret-min-32
JWT_REFRESH_SECRET=please-set-strong-secret-min-32
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
COOKIE_SECRET=please-set-strong-secret-min-32

# --- CORS --------------------------------------------------------------------
# In Production mind. 1 Eintrag, kein "*".
CORS_ORIGINS=https://tanklotse.de,https://admin.tanklotse.de

# --- Rate-Limit -------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=300

# =============================================================================
# Externe APIs / Provider
# =============================================================================

# --- Provider-Simulation-Mode (Audit §22 Phase 8 / PR #11) -----------------
# Production laeuft IMMER gegen Live-APIs. Mock/Contract-Modi sind hart
# blockiert (Production-Guard wirft beim Start). Wer das umgehen will,
# muss `ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=true` setzen — bewusste
# Sondersituation, niemals als „live verifiziert" zaehlbar.
FUEL_PROVIDER_MODE=live
ROUTING_PROVIDER_MODE=live
GEOCODER_PROVIDER_MODE=live
PUSH_PROVIDER=firebase
PUSH_PROVIDER_MODE=live
AUTH_PROVIDER_MODE=live
PAYMENT_PROVIDER_MODE=live
ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=false

# --- Fuel-Provider ---------------------------------------------------------
FUEL_PROVIDER=tankerkoenig
TANKERKOENIG_API_KEY=replace-me
TANKERKOENIG_BASE_URL=https://creativecommons.tankerkoenig.de/json

MTSK_ENABLED=false
MTSK_API_KEY=replace-me
MTSK_BASE_URL=replace-me

# --- Geocoder ---------------------------------------------------------------
GEOCODER_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Pflicht in Production: ein sinnvoller User-Agent-String.
NOMINATIM_USER_AGENT=TankLotse/1.0 contact@tanklotse.de
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=TankLotse/1.0 contact@tanklotse.de
MAPBOX_GEOCODING_BASE_URL=https://api.mapbox.com/geocoding/v5

# --- Mapbox Tokens ----------------------------------------------------------
# Server-Token: nie ins Frontend.
MAPBOX_ACCESS_TOKEN=replace-me
# Public Token fuer Mobile-App (--dart-define).
MAPBOX_PUBLIC_TOKEN=replace-me

# --- Routing -----------------------------------------------------------------
# In Production: ROUTING_PROVIDER=noop ist NUR erlaubt, wenn ROUTING_ENABLED=false.
# Wichtig: ENV-Konfig allein bedeutet NICHT precise_routing — siehe docs/48 §3.4.
ROUTING_ENABLED=false
ROUTING_PROVIDER=noop
MAPBOX_DIRECTIONS_BASE_URL=https://api.mapbox.com/directions/v5
GRAPHHOPPER_API_KEY=replace-me
GRAPHHOPPER_BASE_URL=https://graphhopper.com/api/1

# Routing-Kostenkontrolle (Audit §13 Aufgabe 2+3+9):
# Pre-Sort der Empfehlungen, dann nur Top-N routen. Limit auf 10 ist ein
# vernuenftiger Default — bei vielen Tankstellen pro Suche reduziert das
# die Mapbox-Kosten drastisch.
ROUTING_MAX_CANDIDATES=10
ROUTING_CONCURRENCY=4
MAPBOX_TIMEOUT_MS=4000
MAPBOX_CACHE_TTL_S=1800
# Slice B (PR #15-Audit): Mapbox-Cost-Caps fehlten in der Production-Vorlage,
# obwohl Staging-Templates sie hatten. Operator vor Go-Live an die echten
# Mapbox-Tarif-Limits anpassen.
MAPBOX_DAILY_REQUEST_LIMIT=1000
MAPBOX_WARN_REQUESTS_PER_HOUR=200

# --- Push (FCM) -------------------------------------------------------------
PUSH_ENABLED=false
# Variante A (Inline):
FCM_PROJECT_ID=replace-me
FCM_CLIENT_EMAIL=replace-me
FCM_PRIVATE_KEY=replace-me
# Variante B (Datei-Pfad, existing):
FCM_SERVICE_ACCOUNT_PATH=/run/secrets/fcm-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

# --- Google Login -----------------------------------------------------------
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_CALLBACK_URL=https://api.tanklotse.de/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=replace-me

# --- Apple Login ------------------------------------------------------------
APPLE_LOGIN_ENABLED=false
APPLE_BUNDLE_ID=de.tanklotse.app
APPLE_SERVICE_ID=replace-me
APPLE_TEAM_ID=replace-me
APPLE_KEY_ID=replace-me
APPLE_PRIVATE_KEY=replace-me
APPLE_CALLBACK_URL=https://api.tanklotse.de/api/auth/apple/callback

# --- Subscriptions / In-App-Purchases ---------------------------------------
SUBSCRIPTIONS_ENABLED=false
SUBSCRIPTION_PROVIDER=none

APPLE_IAP_ENABLED=false
APPLE_SHARED_SECRET=replace-me
APPLE_IAP_SHARED_SECRET=replace-me
APPLE_APP_STORE_ISSUER_ID=replace-me
APPLE_APP_STORE_KEY_ID=replace-me
APPLE_APP_STORE_PRIVATE_KEY=replace-me

GOOGLE_PLAY_BILLING_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=de.tanklotse.app
GOOGLE_SERVICE_ACCOUNT_JSON=replace-me
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=/run/secrets/google-play-service-account.json

STRIPE_ENABLED=false
STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
STRIPE_PRICE_ID_PREMIUM_MONTHLY=replace-me
STRIPE_PRICE_ID_PREMIUM_YEARLY=replace-me

# --- Sentry -----------------------------------------------------------------
SENTRY_ENABLED=false
SENTRY_DSN=replace-me
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# --- Mail / SMTP ------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=replace-me
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_PASSWORD=replace-me
MAIL_FROM=no-reply@tanklotse.de
SMTP_FROM="TankLotse <no-reply@tanklotse.de>"

# --- Admin Seed -------------------------------------------------------------
# Wird beim ersten Bootstrap genutzt. Danach bewusst rotieren.
ADMIN_SEED_EMAIL=admin@tanklotse.de
ADMIN_SEED_PASSWORD=replace-with-strong-password

# --- Web-Frontend-Variablen -------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.tanklotse.de
NEXT_PUBLIC_SITE_URL=https://tanklotse.de
NEXT_PUBLIC_SUPPORT_EMAIL=support@tanklotse.de
