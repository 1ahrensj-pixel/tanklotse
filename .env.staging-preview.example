# =============================================================================
# TankLotse — Staging-Preview-Environment-Beispiel (PR #14)
# =============================================================================
# Diese Datei ist die Vorlage fuer den Mock-/Contract-Modus, in dem die
# Staging-Preview im Browser sichtbar ist — OHNE echte API-Keys.
#
# Wichtig: alle Secret-Werte (`replace-me-...`) werden ueber das
# Deployment-Panel des Hosters (Railway/Render) gesetzt — niemals echte
# Werte hier committen. `.env.staging-preview` ist in `.gitignore`.
#
# Doku: docs/64-staging-preview-deployment.md
# =============================================================================

NODE_ENV=staging
PORT=3000
PUBLIC_API_BASE_URL=https://api-staging-preview.example.invalid
APP_NAME=TankLotse
APP_ENV=staging-preview

# --- Datenbank + Cache (Hoster-managed) -------------------------------------
DATABASE_URL=replace-me-with-render-or-railway-postgres-url
REDIS_URL=replace-me-with-render-or-railway-redis-url

# --- Auth / Tokens / Cookies (zwingend in staging) -------------------------
# Mindestlaenge je 32 Zeichen. Im Deploy-Panel mit zufaelligen Werten setzen.
JWT_ACCESS_SECRET=replace-with-random-32-plus-chars-not-a-real-secret
JWT_REFRESH_SECRET=replace-with-random-32-plus-chars-not-a-real-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
COOKIE_SECRET=replace-with-random-32-plus-chars-not-a-real-secret

# --- CORS (Frontend-URLs nach Vercel-Deploy eintragen) ---------------------
CORS_ORIGINS=https://admin-staging-preview.example.invalid,https://staging-preview.example.invalid

# --- Rate-Limit -------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=200

# =============================================================================
# Provider-Simulation-Mode (PR #11/#12) — alles Mock fuer Staging-Preview
# =============================================================================
FUEL_PROVIDER=tankerkoenig
FUEL_PROVIDER_MODE=mock

ROUTING_PROVIDER=mapbox
ROUTING_PROVIDER_MODE=mock
ROUTING_ENABLED=true

GEOCODER_PROVIDER=nominatim
GEOCODER_PROVIDER_MODE=mock

PUSH_PROVIDER=firebase
PUSH_PROVIDER_MODE=disabled

AUTH_PROVIDER_MODE=disabled
PAYMENT_PROVIDER_MODE=disabled

# Mock in Production hart blockieren — Staging-Preview laeuft in NODE_ENV=staging,
# nicht production, der Guard wird also gar nicht aktiv. Trotzdem Default false.
ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=false

# Pflicht-Header fuer den Tag, an dem Geocoder live geschaltet wird.
NOMINATIM_USER_AGENT=TankLotse-Staging-Preview/1.0 (+ops@example.invalid)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Routing-Cost-Controls (greifen erst in mode=live).
ROUTING_MAX_CANDIDATES=10
ROUTING_CONCURRENCY=4
MAPBOX_TIMEOUT_MS=4000
MAPBOX_CACHE_TTL_S=1800
MAPBOX_DAILY_REQUEST_LIMIT=1000
MAPBOX_WARN_REQUESTS_PER_HOUR=200

# =============================================================================
# Folgende Variablen sind in Mock-/disabled-Modi NICHT erforderlich.
# Nur eintragen, wenn der entsprechende Provider auf live geschaltet wird.
# Schritt-fuer-Schritt-Anleitung: docs/63-api-key-onboarding-runbook.md
# =============================================================================
# TANKERKOENIG_API_KEY=replace-me
# MAPBOX_ACCESS_TOKEN=replace-me
# MAPBOX_PUBLIC_TOKEN=replace-me
# FCM_SERVICE_ACCOUNT_PATH=/opt/tanklotse/secrets/fcm.json
# GOOGLE_CLIENT_ID=replace-me
# GOOGLE_CLIENT_SECRET=replace-me
# APPLE_BUNDLE_ID=replace-me
# APPLE_TEAM_ID=replace-me
# APPLE_KEY_ID=replace-me
# APPLE_PRIVATE_KEY=replace-me-with-content-of-AuthKey-XXXX.p8
# STRIPE_SECRET_KEY=replace-me
# STRIPE_WEBHOOK_SECRET=replace-me
