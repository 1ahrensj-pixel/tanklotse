# =============================================================================
# TankLotse — Beispiel-Environment (Development / lokale Maschine)
# =============================================================================
# Kopiere zu .env und trage echte Werte ein. .env ist in .gitignore.
# NIEMALS echte Keys committen.
#
# Production-Variante: siehe .env.production.example
# Doku: docs/48-external-api-configuration.md
# =============================================================================

# --- Allgemein --------------------------------------------------------------
NODE_ENV=development
PORT=3000
PUBLIC_API_BASE_URL=http://localhost:3000
APP_NAME=TankLotse
APP_ENV=development
# Alias (existing): API_BASE_URL
API_BASE_URL=http://localhost:3000

# Swagger UI unter /docs/api. In non-production (development/staging/test) immer
# aktiv. In production standardmaessig AUS — bewusst per `SWAGGER_ENABLED=true`
# aktivieren, falls noetig (interne Debug-Zwecke). Nicht oeffentlich ohne
# zusaetzlichen Schutz betreiben.
SWAGGER_ENABLED=true

# --- Datenbank + Cache ------------------------------------------------------
DATABASE_URL=postgresql://tanklotse:tanklotse@localhost:5432/tanklotse
POSTGRES_USER=tanklotse
POSTGRES_PASSWORD=tanklotse
POSTGRES_DB=tanklotse

REDIS_URL=redis://localhost:6379

# --- Auth / Tokens / Cookies -----------------------------------------------
# Pflicht in Production (Mindestlaenge 32 Zeichen).
JWT_ACCESS_SECRET=please-set-strong-secret-min-32
JWT_REFRESH_SECRET=please-set-strong-secret-min-32
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
COOKIE_SECRET=please-set-strong-secret-min-32

# --- CORS --------------------------------------------------------------------
# Komma-getrennt. In Production mind. 1 Eintrag, kein "*".
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# --- Rate-Limit -------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Brute-Force-Schutz: strengere IP-Limits (Requests/Minute) auf sensiblen
# Auth-Endpunkten — Defense-in-Depth zusaetzlich zum Account-Lockout.
# Production: niedrig lassen. Lokal/CI: hoch setzen, sonst blockieren
# E2E-Suiten sich selbst.
AUTH_RATE_LIMIT_LOGIN=10
AUTH_RATE_LIMIT_REGISTER=10
AUTH_RATE_LIMIT_FORGOT=5
AUTH_RATE_LIMIT_RESET=10

# =============================================================================
# Externe APIs / Provider — feature-flag-basiert konfigurierbar.
# =============================================================================

# --- Provider-Simulation-Mode (Audit §22 Phase 8 / PR #11) -----------------
# Pro Adapter ein Modus: live | sandbox | mock | contract | disabled
#   live      = echte API
#   sandbox   = Provider-Sandbox (Stripe Test, Apple Sandbox, ...)
#   mock      = lokaler In-Memory-Mock — niemals als „live geprueft" zaehlbar
#   contract  = lokal mit gespeicherten Provider-Antworten als Fixture
#   disabled  = Adapter nicht geladen
FUEL_PROVIDER_MODE=live
ROUTING_PROVIDER_MODE=live
GEOCODER_PROVIDER_MODE=live
# PUSH_PROVIDER waehlt den konkreten Push-Adapter, sobald PUSH_ENABLED=true
# gesetzt ist. Heute nur firebase (FCM) implementiert.
PUSH_PROVIDER=firebase
PUSH_PROVIDER_MODE=disabled
AUTH_PROVIDER_MODE=disabled
PAYMENT_PROVIDER_MODE=disabled
# Production-Schutz: in NODE_ENV=production wird *_PROVIDER_MODE=mock
# normalerweise blockiert. Nur fuer bewusste Demos / Smoketests in Prod
# auf true setzen — Mocks zaehlen niemals als „live verifiziert".
ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=false

# --- Fuel-Provider (Spritpreise) -------------------------------------------
# Werte: tankerkoenig | mtsk | mock
FUEL_PROVIDER=tankerkoenig

# Tankerkoenig (NIE in Mobile/Frontend einbauen!)
TANKERKOENIG_API_KEY=replace-me
TANKERKOENIG_BASE_URL=https://creativecommons.tankerkoenig.de/json

# MTS-K (Markttransparenzstelle Kraftstoffe) — vorbereitet, ohne echten
# Vertrag aktuell nicht produktiv.
MTSK_ENABLED=false
MTSK_API_KEY=replace-me
MTSK_BASE_URL=replace-me

# --- Geocoder (Adresse → lat/lng) ------------------------------------------
# Werte: nominatim | mapbox | mock
GEOCODER_PROVIDER=nominatim

# Nominatim (kostenlos, Pflicht: User-Agent gemaess Nutzungsbedingungen)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=TankLotse/1.0 local-dev@example.test
# Aliase fuer existing Code:
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=TankLotse/1.0 local-dev@example.test

# Mapbox Geocoding (alternative zu Nominatim, kostenpflichtig)
MAPBOX_GEOCODING_BASE_URL=https://api.mapbox.com/geocoding/v5

# --- Mapbox Tokens ----------------------------------------------------------
# MAPBOX_ACCESS_TOKEN: server-seitiger Token, nie ins Frontend.
# MAPBOX_PUBLIC_TOKEN: oeffentlicher Token fuer die Mobile-Karte
#   (--dart-define=MAPBOX_PUBLIC_TOKEN=...)
MAPBOX_ACCESS_TOKEN=replace-me
MAPBOX_PUBLIC_TOKEN=replace-me

# --- Routing (echte Fahrwege) -----------------------------------------------
# Werte: noop | mapbox | graphhopper
# noop = Luftlinien-Naeherung. In Production verboten, wenn ROUTING_ENABLED=true.
# Wichtig: ENV-Konfig allein bedeutet NICHT precise_routing — siehe docs/48 §3.4.
ROUTING_ENABLED=false
ROUTING_PROVIDER=noop
MAPBOX_DIRECTIONS_BASE_URL=https://api.mapbox.com/directions/v5
GRAPHHOPPER_API_KEY=replace-me
GRAPHHOPPER_BASE_URL=https://graphhopper.com/api/1

# Routing-Kostenkontrolle (Audit 2026-05-06 §13 Aufgabe 2+3+9):
# ROUTING_MAX_CANDIDATES begrenzt echte Routing-Calls pro Empfehlungslauf.
#   Pre-Sort sortiert nach approximativer Ersparnis, dann werden NUR die
#   ersten N Kandidaten geroutet. Restliche bleiben Schaetzung.
# ROUTING_CONCURRENCY begrenzt parallele Routing-Calls. Schuetzt vor
#   Mapbox-Rate-Limits.
# MAPBOX_TIMEOUT_MS verhindert haengende Calls (AbortController).
# MAPBOX_CACHE_TTL_S reduziert Kosten + Rate-Limits via Redis-Cache.
ROUTING_MAX_CANDIDATES=10
ROUTING_CONCURRENCY=4
MAPBOX_TIMEOUT_MS=4000
MAPBOX_CACHE_TTL_S=1800

# --- Push (Firebase Cloud Messaging) ---------------------------------------
PUSH_ENABLED=false
# Variante A (Inline, neuer Auftrags-Stil):
FCM_PROJECT_ID=replace-me
FCM_CLIENT_EMAIL=replace-me
FCM_PRIVATE_KEY=replace-me
# Variante B (Datei-Pfad, existing PushService nutzt das):
FCM_SERVICE_ACCOUNT_PATH=./secrets/fcm-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

# --- Google Login -----------------------------------------------------------
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Alias fuer existing oauth.service.ts: GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_ID=replace-me

# --- Apple Login ------------------------------------------------------------
APPLE_LOGIN_ENABLED=false
APPLE_BUNDLE_ID=de.tanklotse.app
APPLE_SERVICE_ID=replace-me
APPLE_TEAM_ID=replace-me
APPLE_KEY_ID=replace-me
APPLE_PRIVATE_KEY=replace-me
APPLE_CALLBACK_URL=http://localhost:3000/api/auth/apple/callback

# --- Subscriptions / In-App-Purchases ---------------------------------------
# SUBSCRIPTIONS_ENABLED=true verlangt SUBSCRIPTION_PROVIDER (kein "none").
# Werte: none | apple | google | apple_google | stripe
SUBSCRIPTIONS_ENABLED=false
SUBSCRIPTION_PROVIDER=none

# Apple IAP
APPLE_IAP_ENABLED=false
APPLE_SHARED_SECRET=replace-me
# Alias fuer existing subscription.service.ts:
APPLE_IAP_SHARED_SECRET=replace-me
APPLE_APP_STORE_ISSUER_ID=replace-me
APPLE_APP_STORE_KEY_ID=replace-me
APPLE_APP_STORE_PRIVATE_KEY=replace-me

# Google Play Billing
GOOGLE_PLAY_BILLING_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=de.tanklotse.app
GOOGLE_SERVICE_ACCOUNT_JSON=replace-me
# Alias fuer existing subscription.service.ts (Datei-Pfad):
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=./secrets/google-play-service-account.json

# Stripe
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
STRIPE_PRICE_ID_PREMIUM_MONTHLY=replace-me
STRIPE_PRICE_ID_PREMIUM_YEARLY=replace-me

# --- Sentry / Monitoring ----------------------------------------------------
SENTRY_ENABLED=false
SENTRY_DSN=replace-me
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# --- Mail / SMTP ------------------------------------------------------------
# Lokal (Mailpit): SMTP_ENABLED=true, SMTP_HOST=localhost, SMTP_PORT=1026
#   → docker compose -p tanklotse -f infrastructure/docker-compose.dev.yml up -d
#   → Mails ansehen: http://localhost:8026
# Production: echten SMTP-Provider (z. B. Postmark, SES) eintragen.
SMTP_ENABLED=false
SMTP_HOST=replace-me
SMTP_PORT=587
SMTP_USER=replace-me
# Variante A (Auftrag): SMTP_PASS
SMTP_PASS=replace-me
# Variante B (existing mailer.service.ts): SMTP_PASSWORD
SMTP_PASSWORD=replace-me
# Variante A (Auftrag): MAIL_FROM
MAIL_FROM=no-reply@example.test
# Variante B (existing): SMTP_FROM
SMTP_FROM="TankLotse <noreply@example.test>"

# --- Admin Seed -------------------------------------------------------------
ADMIN_SEED_EMAIL=admin@tanklotse.local
ADMIN_SEED_PASSWORD=replace-with-strong-password

# --- Demo-Seed (optional, Standardwert: Demo1234!dev) -----------------------
# DEMO_SEED_PASSWORD=Demo1234!dev

# --- Admin-Dashboard --------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Landingpage ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://tanklotse.de
NEXT_PUBLIC_SUPPORT_EMAIL=support@tanklotse.de
