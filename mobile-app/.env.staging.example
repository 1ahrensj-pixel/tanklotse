# =============================================================================
# TankLotse Mobile-App — Staging-Build-Vorlage (Auditor §22 Phase 7)
# =============================================================================
# Diese Werte werden NICHT als Datei geladen — Flutter nutzt
# `--dart-define`-Parameter beim Build. Die Datei dient nur zur Doku, was
# der Betreiber pro Staging-Build setzen muss.
# =============================================================================

# Base-URL des Staging-Backends.
API_BASE_URL=https://api-staging.tanklotse.de

# Mapbox Public Token — DARF in der Mobile-App gebundelt werden, weil er
# nur fuer Karten-Tiles + Suche gilt und durch URL-Restrictions gegen Missbrauch
# geschuetzt ist. NIEMALS den server-seitigen MAPBOX_ACCESS_TOKEN hier nutzen.
MAPBOX_PUBLIC_TOKEN=replace-me

# --- Beispiel-Builds --------------------------------------------------------
# Android Debug:
#   flutter build apk --debug \
#     --dart-define=API_BASE_URL=https://api-staging.tanklotse.de \
#     --dart-define=MAPBOX_PUBLIC_TOKEN=pk.real-public-token
#
# iOS Debug (auf macOS):
#   flutter build ios --debug \
#     --dart-define=API_BASE_URL=https://api-staging.tanklotse.de \
#     --dart-define=MAPBOX_PUBLIC_TOKEN=pk.real-public-token
#
# Web (Staging-Test):
#   flutter build web --release \
#     --dart-define=API_BASE_URL=https://api-staging.tanklotse.de \
#     --dart-define=MAPBOX_PUBLIC_TOKEN=pk.real-public-token
