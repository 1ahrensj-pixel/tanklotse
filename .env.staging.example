# =============================================================================
# TankLotse — Staging-Environment-Beispiel (Auditor §22 Phase 1)
# =============================================================================
# Diese Datei beschreibt den Stand fuer die Staging-Umgebung. Sie enthaelt
# KEINE echten Secrets. Alle Werte sind klar als Platzhalter erkennbar
# (`replace-me` / `PLEASE_SET_RANDOM_32_CHARS_MIN`).
#
# Beim Deployment in echtes Staging die Werte ueber Server-Panel /
# Docker-Secrets / Deployment-System setzen — niemals echte Werte committen.
# `.env.staging` ist bereits in `.gitignore`.
#
# Doku: docs/56-staging-live-api-test-report.md
# =============================================================================

# --- Allgemein --------------------------------------------------------------
NODE_ENV=staging
PORT=3000
PUBLIC_API_BASE_URL=https://api-staging.tanklotse.de
APP_NAME=TankLotse
APP_ENV=staging
API_BASE_URL=https://api-staging.tanklotse.de

# Swagger UI: in staging bewusst aktivierbar (interne Tests). In production
# standardmaessig aus.
SWAGGER_ENABLED=false

# --- Datenbank + Cache ------------------------------------------------------
DATABASE_URL=replace-me
REDIS_URL=replace-me

# --- Auth / Tokens / Cookies -----------------------------------------------
# Pflicht in Staging/Production (Mindestlaenge je 32 Zeichen).
JWT_ACCESS_SECRET=PLEASE_SET_RANDOM_32_CHARS_MIN
JWT_REFRESH_SECRET=PLEASE_SET_RANDOM_32_CHARS_MIN
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
COOKIE_SECRET=PLEASE_SET_RANDOM_32_CHARS_MIN

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=https://staging.tanklotse.de,https://admin-staging.tanklotse.de

# --- Rate-Limit -------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=200

# =============================================================================
# Externe APIs / Provider — staging-Setup
# =============================================================================

# --- Provider-Simulation-Mode (Audit §22 Phase 8 / PR #11) -----------------
# Staging laeuft normalerweise gegen LIVE-APIs (echtes Tankerkoenig + Mapbox).
# Fuer offline-Tests koennen einzelne Adapter auf `mock` oder `contract`
# umgeschaltet werden — der Status-Endpoint meldet das ehrlich als
# `mock_ready` / `contract_ready`, niemals als `live_verified`.
FUEL_PROVIDER_MODE=live
ROUTING_PROVIDER_MODE=live
GEOCODER_PROVIDER_MODE=live
PUSH_PROVIDER=firebase
PUSH_PROVIDER_MODE=disabled
AUTH_PROVIDER_MODE=disabled
PAYMENT_PROVIDER_MODE=disabled
ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=false

# --- Fuel-Provider ---------------------------------------------------------
FUEL_PROVIDER=tankerkoenig
TANKERKOENIG_API_KEY=replace-me
TANKERKOENIG_BASE_URL=https://creativecommons.tankerkoenig.de/json

MTSK_ENABLED=false
MTSK_API_KEY=replace-me
MTSK_BASE_URL=replace-me

# --- Geocoder ---------------------------------------------------------------
GEOCODER_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=TankLotse-Staging/1.0 contact@example.de
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=TankLotse-Staging/1.0 contact@example.de

# --- Routing (echte Fahrwege via Mapbox in Staging aktiviert) --------------
ROUTING_ENABLED=true
ROUTING_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=replace-me
MAPBOX_PUBLIC_TOKEN=replace-me
MAPBOX_DIRECTIONS_BASE_URL=https://api.mapbox.com/directions/v5
MAPBOX_GEOCODING_BASE_URL=https://api.mapbox.com/geocoding/v5

# Routing-Kostenkontrolle (Auditor §13 + §17):
# Pre-Sort + Top-N + Concurrency + Cache reduzieren Mapbox-Calls drastisch.
ROUTING_MAX_CANDIDATES=10
ROUTING_CONCURRENCY=4
MAPBOX_TIMEOUT_MS=4000
MAPBOX_CACHE_TTL_S=1800

# Optionale Tageslimits (Auditor §22 Phase 5).
# Ueberschreitung wird aktuell nur geloggt — harte Drossel ist Folge-PR.
MAPBOX_DAILY_REQUEST_LIMIT=1000
MAPBOX_WARN_REQUESTS_PER_HOUR=200

GRAPHHOPPER_API_KEY=replace-me
GRAPHHOPPER_BASE_URL=https://graphhopper.com/api/1

# --- Push (FCM) — in Staging deaktiviert -----------------------------------
PUSH_ENABLED=false
FCM_SERVICE_ACCOUNT_PATH=/run/secrets/fcm-service-account.json

# --- Logins — in Staging deaktiviert ---------------------------------------
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_OAUTH_CLIENT_ID=replace-me
GOOGLE_CALLBACK_URL=https://api-staging.tanklotse.de/api/auth/google/callback

APPLE_LOGIN_ENABLED=false
APPLE_BUNDLE_ID=de.tanklotse.app
APPLE_TEAM_ID=replace-me
APPLE_KEY_ID=replace-me
APPLE_PRIVATE_KEY=replace-me

# --- Subscriptions — in Staging deaktiviert --------------------------------
SUBSCRIPTIONS_ENABLED=false
SUBSCRIPTION_PROVIDER=none

# --- Sentry — optional, off bis bewusst aktiviert --------------------------
SENTRY_ENABLED=false
SENTRY_DSN=replace-me
SENTRY_ENVIRONMENT=staging

# --- SMTP — in Staging deaktiviert -----------------------------------------
SMTP_ENABLED=false
SMTP_HOST=replace-me
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
MAIL_FROM=no-reply@staging.tanklotse.de

# --- Admin Seed -------------------------------------------------------------
ADMIN_SEED_EMAIL=admin@staging.tanklotse.de
ADMIN_SEED_PASSWORD=replace-with-strong-password

# --- Web-Frontend-Variablen -------------------------------------------------
NEXT_PUBLIC_API_URL=https://api-staging.tanklotse.de
NEXT_PUBLIC_SITE_URL=https://staging.tanklotse.de
NEXT_PUBLIC_SUPPORT_EMAIL=support-staging@tanklotse.de

# --- Live-API-Tests ---------------------------------------------------------
# Diese Flag aktiviert die staging-only E2E-Tests (siehe
# `backend/test/staging-live-api.e2e-spec.ts`). Ohne `true` werden die Tests
# uebersprungen — sie verbrauchen API-Kontingent.
RUN_LIVE_API_TESTS=false
