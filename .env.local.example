# =============================================================================
# TankLotse — Lokale Entwicklungsumgebung  (.env.local)
# =============================================================================
# Kopiere diese Datei zu `backend/.env` und passe ggf. die Werte an.
# .env.local ist in .gitignore — keine echten Secrets committen!
#
# Voraussetzung: Docker-Stack läuft
#   docker compose -p tanklotse -f infrastructure/docker-compose.dev.yml up -d
#
# Ports (abweichend von Standard, um Konflikte zu vermeiden):
#   Postgres   localhost:5435   (Standard wäre 5432)
#   Redis      localhost:6381   (Standard wäre 6379)
#   Mailpit    SMTP :1026 / UI  http://localhost:8026
#   Adminer    http://localhost:8081
#
# Backend    http://localhost:3000  (npm run start:dev in backend/)
# Landing    http://localhost:3001  (npm run dev in landingpage/)
# Admin-UI   http://localhost:3002  (npm run dev in admin-dashboard/)
#
# Alle Provider laufen im Mock-Modus — kein API-Kontingent wird verbraucht.
# =============================================================================

# --- Allgemein ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME=TankLotse
APP_ENV=development
API_BASE_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:3000
SWAGGER_ENABLED=true

# --- Datenbank + Cache -------------------------------------------------------
# Ports auf 5435/6381 — Docker-Stack nutzt Offset-Ports
DATABASE_URL=postgresql://tanklotse:tanklotse@localhost:5435/tanklotse
POSTGRES_USER=tanklotse
POSTGRES_PASSWORD=tanklotse
POSTGRES_DB=tanklotse

REDIS_URL=redis://localhost:6381

# --- Auth / Tokens / Cookies -------------------------------------------------
# Nur für lokale Entwicklung — niemals in Production verwenden!
JWT_ACCESS_SECRET=local-dev-access-secret-min-32-chars-aaaa
JWT_REFRESH_SECRET=local-dev-refresh-secret-min-32-chars-bbb
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
COOKIE_SECRET=local-dev-cookie-secret-min-32-chars-ccccc

# --- CORS --------------------------------------------------------------------
# 3004 = Ausweich-Port für den Admin, falls 3002 von einer fremden App belegt
# ist (siehe README_LOCAL "Häufige Probleme").
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3004

# --- Rate-Limit (lokal großzügig) -------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=1000
# Brute-Force-Limits auf Auth-Endpunkten: lokal hoch, sonst sperren sich
# E2E-Suiten (viele Logins/min) selbst aus. Production-Werte: siehe .env.example.
AUTH_RATE_LIMIT_LOGIN=100
AUTH_RATE_LIMIT_REGISTER=100
AUTH_RATE_LIMIT_FORGOT=100
AUTH_RATE_LIMIT_RESET=100

# --- Provider-Modi (alle Mock) -----------------------------------------------
# Kein externer API-Key benötigt; alle Antworten kommen aus In-Memory-Mocks.
FUEL_PROVIDER_MODE=mock
ROUTING_PROVIDER_MODE=mock
GEOCODER_PROVIDER_MODE=mock
PUSH_PROVIDER=firebase
PUSH_PROVIDER_MODE=disabled
AUTH_PROVIDER_MODE=disabled
PAYMENT_PROVIDER_MODE=disabled
ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=false

# --- Fuel-Provider -----------------------------------------------------------
FUEL_PROVIDER=tankerkoenig
TANKERKOENIG_API_KEY=not-needed-in-mock-mode
TANKERKOENIG_BASE_URL=https://creativecommons.tankerkoenig.de/json
MTSK_ENABLED=false

# --- Geocoder ----------------------------------------------------------------
GEOCODER_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=TankLotse/1.0 local-dev@example.test
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=TankLotse/1.0 local-dev@example.test

# --- Routing -----------------------------------------------------------------
ROUTING_ENABLED=false
ROUTING_PROVIDER=noop
ROUTING_MAX_CANDIDATES=10
ROUTING_CONCURRENCY=4
MAPBOX_TIMEOUT_MS=4000
MAPBOX_CACHE_TTL_S=1800

# --- Push / Mail / OAuth / Payments (lokal deaktiviert) ----------------------
PUSH_ENABLED=false
GOOGLE_LOGIN_ENABLED=false
APPLE_LOGIN_ENABLED=false
SUBSCRIPTIONS_ENABLED=false
SUBSCRIPTION_PROVIDER=none
STRIPE_ENABLED=false
SENTRY_ENABLED=false

# --- Mail (Mailpit) ----------------------------------------------------------
# Mailpit fängt alle ausgehenden Mails ab. Web-UI: http://localhost:8026
# KEINE echten Mails werden verschickt.
# User/Passwort sind Dummy-Werte: Mailpit akzeptiert beliebige Auth
# (MP_SMTP_AUTH_ACCEPT_ANY=1), aber die Backend-Validation verlangt
# bei SMTP_ENABLED=true nicht-leere Werte — leer lassen = Boot-Crash!
SMTP_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=mailpit
SMTP_PASS=mailpit
SMTP_PASSWORD=mailpit
MAIL_FROM=no-reply@tanklotse.local
SMTP_FROM="TankLotse Dev <noreply@tanklotse.local>"

# --- Admin-Seed --------------------------------------------------------------
# Passwort für den SuperAdmin (min. 12 Zeichen)
ADMIN_SEED_EMAIL=admin@tanklotse.local
ADMIN_SEED_PASSWORD=local-dev-admin-password-min-12chars

# --- Demo-Seed ---------------------------------------------------------------
# Optionaler Wert; Default ist Demo1234!dev wenn nicht gesetzt
DEMO_SEED_PASSWORD=Demo1234!dev

# --- Frontend-Apps -----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_SUPPORT_EMAIL=support@tanklotse.local
